<?scripta
echo "Host: " . System::hostname() . "\n";
echo "Platform: " . System::platform() . "\n";
echo "Architecture: " . System::architecture() . "\n";
$disk = System::diskUsage(System::tempDirectory());
echo "Disk used: " . str($disk->percentUsed) . "%\n";
if ($disk->percentUsed > 85.0)
    Log::warn("Disk capacity warning");
$memory = System::memoryUsage();
echo "System RAM available: " . str($memory->availableBytes) . " bytes\n";
echo "CPU sample: " . str(System::cpuUsage()) . "%\n";
echo "UTC: " . Date::format(Date::now(), "%Y-%m-%dT%H:%M:%S%.3fZ") . "\n";
Log::info("Host check complete");
