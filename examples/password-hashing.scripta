<?scripta
// Public demo input only. Real applications receive passwords through their login flow.
$password = "public example password";
$hash = Password::hash($password);
$verified = Password::verify($password, $hash);
$needsRehash = Password::needsRehash($hash);
// Store the complete hash in your database; do not print passwords or hashes in logs.
echo Json::encode(["algorithm" => "argon2id", "verified" => $verified, "needsRehash" => $needsRehash]) . "\n";
