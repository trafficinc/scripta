// Calendar units preserve wall time; durations measure elapsed seconds.
$monthEnd = Date::addCalendar(Date::parse("2024-01-31T12:00:00Z"), 1, "month");
echo "Month end: " . Date::format($monthEnd, "%Y-%m-%d") . "\n";
$start = Date::parse("2024-03-09T12:00:00-05:00");
$calendarDay = Date::addCalendar($start, 1, "day", "America/New_York");
$elapsedDay = Date::addSeconds($start, Duration::parse("P1D"));
echo "Calendar day: " . str(Date::diff($start, $calendarDay)) . " seconds\n";
echo "Elapsed day: " . str(Date::diff($start, $elapsedDay)) . " seconds\n";
echo "Negative duration: " . str(Duration::parse("-PT90M")) . " seconds\n";
try {
    Date::addCalendar(Date::parse("2024-03-09T02:30:00-05:00"), 1, "day", "America/New_York");
} catch (DateError $error) {
    echo "Nonexistent local time rejected\n";
}
