<?scripta
$scores = ["Alice" => 92, "Bob" => 68, "Charlie" => 45];
foreach ($scores as $name => $score) {
    $grade = "";
    if ($score >= 90) {
        $grade = "Excellent";
    } elseif ($score >= 60) {
        $grade = "Pass";
    } else {
        $grade = "Try again";
    }
    echo $name . ": " . $grade . "\n";
}
