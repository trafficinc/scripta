<?scr
// Usage: scripta run playground/streaming.scripta <events-file|->
$path = Cli::arg(0);
if ($path === null) {
    echo "Usage: scripta run playground/streaming.scripta <events-file|->\n";
    exit 2;
}
$counts = Map::create();
$malformed = 0;
$records = 0;
$stream = null;
if ($path !== "-") {
    $stream = File::openLines($path, 65536);
}
try {
    while (true) {
        $line = null;
        if ($stream === null) {
            $line = Cli::readLine(65536);
        } else {
            $line = File::readLine($stream);
        }
        if ($line === null) {
            break;
        }
        $line = String::trim($line);
        if ($line === "" || String::startsWith($line, "#")) {
            continue;
        }
        $fields = String::split($line, "|");
        if (len($fields) !== 3) {
            $malformed += 1;
            continue;
        }
        $level = String::lower(String::trim($fields[0]));
        $service = String::trim($fields[1]);
        $message = String::trim($fields[2]);
        if (!List::contains(["info", "warn", "error"], $level) || $service === "" || $message === "") {
            $malformed += 1;
            continue;
        }
        $counts[$level] = Map::get($counts, $level, 0) + 1;
        $records += 1;
    }
} finally {
    if ($stream !== null) {
        File::close($stream);
    }
}
echo String::format("Records: {}\n", [$records]);
foreach (["info", "warn", "error"] as $level) {
    echo String::format("{}: {}\n", [$level, Map::get($counts, $level, 0)]);
}
echo String::format("Malformed: {}\n", [$malformed]);
if ($stream !== null) {
    echo String::format("Stream closed: {}\n", [$stream->closed]);
}
