
# Source scripts use the formatter's LF output on every checkout platform.
*.scripta text eol=lf
*.scta text eol=lf
*.scr text eol=lf

# Formatter snapshots intentionally contain exact and mixed newline bytes.
# These overrides must follow the general source rules.
crates/scr-cli/tests/snapshots/formatter/*.scripta -text
crates/scr-cli/tests/snapshots/formatter/*.scta -text
crates/scr-cli/tests/snapshots/formatter/*.scr -text

# Benchmark fixture hashes and source bytes are part of the measurement record.
benchmarks/fixtures/* -text

# Keep release inputs stable across checkout platforms.
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.yml text eol=lf
examples/packages/** text eol=lf
LICENSE text eol=lf

# Preserve exact upstream license/provenance bytes checked by SHA-256.
release-notices/** -text
