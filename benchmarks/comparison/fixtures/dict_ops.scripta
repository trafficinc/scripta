$items = Map::create();
for ($i = 0; $i < 256; $i += 1) {
    $items["key" . str($i)] = $i;
}
$total = 0;
for ($i = 0; $i < 40960; $i += 1) {
    $key = "key" . str($i % 256);
    $items[$key] += 1;
    $total += $items[$key];
}
for ($i = 0; $i < 128; $i += 1) {
    $items = Map::remove($items, "key" . str($i));
}
echo str(len($items)) . ":" . str($total) . ":" . str(List::sum(Map::values($items))) . "\n";
