$db = Sqlite::open(":memory:");
try {
    Sqlite::execute($db, "CREATE TABLE items (id INTEGER PRIMARY KEY, value INTEGER NOT NULL)");
    Sqlite::execute($db, "BEGIN");
    for ($i = 0; $i < 10000; $i += 1) {
        Sqlite::execute($db, "INSERT INTO items VALUES (?, ?)", [$i, $i % 17]);
    }
    Sqlite::execute($db, "COMMIT");
    $rows = Sqlite::query($db, "SELECT COUNT(*) AS count, SUM(id) AS ids, SUM(value) AS total, SUM(id * value) AS weighted FROM items");
    $row = $rows[0];
    echo str($row["count"]) . ":" . str($row["ids"]) . ":" . str($row["total"]) . ":" . str($row["weighted"]) . "\n";
} finally {
    Sqlite::close($db);
}
