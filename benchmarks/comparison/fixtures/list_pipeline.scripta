$values = List::fill(2000, 0);
for ($i = 0; $i < 2000; $i += 1) {
    $values[$i] = $i;
}
$total = 0;
$count = 0;
for ($batch = 0; $batch < 200; $batch += 1) {
    $mapped = [$x * 3 for $x in $values];
    $filtered = [$x for $x in $mapped if $x % 2 === 0];
    $count += len($filtered);
    foreach ($filtered as $x) {
        $total += $x;
    }
}
echo str($count) . ":" . str($total) . "\n";
